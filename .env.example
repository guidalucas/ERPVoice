# Parser de intents (WhatsApp / panel web)
# Proveedor primario: Gemini (OpenAI-compatible). Groq queda de fallback.
# Ver MIGRACION_GEMINI.md
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional. Default: gemini-3.5-flash-lite (fallback de modelo: gemini-3.1-flash-lite)
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# GEMINI_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Fallback Groq (se usa si Gemini falla o si LLM_PROVIDER=groq)
VITE_VOICE_MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
VITE_VOICE_MODEL_API_KEY=
VITE_VOICE_MODEL_NAME=openai/gpt-oss-20b
# GROQ_API_KEY=  # alias opcional de VITE_VOICE_MODEL_API_KEY

# Frontend/backend: audio transcription (sigue en Groq Whisper)
VITE_VOICE_TRANSCRIPTION_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
VITE_VOICE_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Backend: Meta/WhatsApp webhook and reply config
META_WEBHOOK_PORT=3001
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# Backend: PostgreSQL / Supabase connection
SUPABASE_DATABASE_URL=

# Frontend: local API base URLs
VITE_META_API_BASE=http://localhost:3001

# Número público de WhatsApp Business (dígitos, para wa.me). Si falta, se intenta leer de Graph.
META_WHATSAPP_NUMBER=

# Login con WhatsApp: el token corto vence en N segundos (60-600, default 300).
AUTH_WA_LOGIN_TTL_SECONDS=300

# Local auth bypass (sin WhatsApp). Si no seteás META_ACCESS_TOKEN, se activa solo.
AUTH_DEV_BYPASS=true
AUTH_DEV_PHONE=5491100000000

# ngrok: required for npm run dev:all
NGROK_AUTHTOKEN=

#npm run dev:all