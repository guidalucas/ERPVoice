# Intérprete universal del backend (WhatsApp / panel web)
# Proveedor primario: Gemini (OpenAI-compatible). Groq queda de fallback.
# Ver MIGRACION_GEMINI.md
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional. Default: gemini-3.5-flash-lite (fallback de modelo: gemini-3.1-flash-lite)
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# GEMINI_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Fallback Groq (se usa si Gemini falla o si LLM_PROVIDER=groq)
VITE_VOICE_MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
VITE_VOICE_MODEL_NAME=openai/gpt-oss-20b
# VITE_VOICE_MODEL_API_KEY es un alias antiguo de servidor; usar GROQ_API_KEY.

# Solo backend: transcripción compartida por Meta y panel autenticado.
# Usa GROQ_API_KEY salvo que se configure una clave específica. Nunca claves VITE.
VOICE_TRANSCRIPTION_API_KEY=
VOICE_TRANSCRIPTION_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
VOICE_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Backend: Meta/WhatsApp webhook and reply config
META_WEBHOOK_PORT=3001
META_VERIFY_TOKEN=
# Meta App Secret: authenticates POST payloads; different from the GET verify token.
# Missing configuration rejects incoming POST deliveries (HTTP 503).
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# Backend: PostgreSQL / Supabase connection
SUPABASE_DATABASE_URL=

# Frontend: local API base URLs
VITE_META_API_BASE=http://localhost:3001

# Optional private Studio origin, exact scheme + host + port, no trailing slash.
# Local Studio http://localhost:5175 is already allowed.
COMMERCE_STUDIO_ORIGIN=

# Private photo storage. Choose explicitly; never creates buckets automatically.
# Production: supabase + an existing PRIVATE bucket and server-only service key.
COMMERCE_MEDIA_ADAPTER=
COMMERCE_STORAGE_URL=
COMMERCE_STORAGE_BUCKET=
COMMERCE_STORAGE_SERVICE_KEY=
# local is allowed only outside production, for isolated fixtures/development.
COMMERCE_MEDIA_DIRECTORY=

# Número público de WhatsApp Business (dígitos, para wa.me). Si falta, se intenta leer de Graph.
META_WHATSAPP_NUMBER=

# Login con WhatsApp: el token corto vence en N segundos (60-600, default 300).
AUTH_WA_LOGIN_TTL_SECONDS=300
# Obligatorio en producción: secreto privado de al menos 32 bytes. No usar META_VERIFY_TOKEN.
AUTH_JWT_SECRET=

# Local auth bypass (sin WhatsApp). Si no seteás META_ACCESS_TOKEN, se activa solo.
AUTH_DEV_BYPASS=true
AUTH_DEV_PHONE=5491100000000

# ngrok: required for npm run dev:all
NGROK_AUTHTOKEN=

#npm run dev:all
